{
  "name": "fabrico-mobile-template",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@fabrico/sdk": "^1.15.72",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "hono": "^4.13.8",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.135.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:tunnel": "node scripts/dev.mjs --tunnel",
    "start": "expo start",
    "build": "expo export --platform web",
    "check": "tsc --noEmit && expo export --platform web && wrangler deploy --dry-run",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "dev:worker": "pnpm build:web && wrangler dev src/worker/index.ts",
    "deploy:worker": "pnpm build:web && wrangler deploy src/worker/index.ts"
  },
  "private": true
}
